OMNIFLOW_ENV=development
OMNIFLOW_HTTP_ADDR=:8080
OMNIFLOW_DATABASE_URL=postgres://omniflow:omniflow@postgres:5432/omniflow?sslmode=disable
OMNIFLOW_VALKEY_URL=redis://valkey:6379/0
OMNIFLOW_REMNAWAVE_URL=https://panel.example.com
OMNIFLOW_REMNAWAVE_TOKEN=replace-me
OMNIFLOW_TELEGRAM_TOKEN=replace-me

# Anonymous, privacy-preserving project telemetry is enabled by default.
OMNIFLOW_TELEMETRY_ENABLED=true
OMNIFLOW_TELEMETRY_ENDPOINT=https://telemetry.omniflw.xyz/v1/telemetry/events
OMNIFLOW_TELEMETRY_COLLECTOR_ENABLED=false

NEXT_PUBLIC_API_URL=http://localhost:8080
