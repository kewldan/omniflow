# Win-back discount waves after a subscription lapses (Bedolaga's expiry waves 2 and 3).
# APP_WINBACK_ENABLED=true
# APP_WINBACK_WAVE2_AFTER_DAYS=2
# APP_WINBACK_WAVE2_PERCENT=10
# APP_WINBACK_WAVE3_AFTER_DAYS=5
# APP_WINBACK_WAVE3_PERCENT=20
# APP_WINBACK_VALID_HOURS=24

# Lifecycle notice thresholds and installation-wide switches.
# APP_NOTIFY_EXPIRY_DAYS=7,3,1,0
# APP_NOTIFY_TRAFFIC_PERCENTS=80,100
# APP_NOTIFY_DISABLED=

