APP_ENV=development
APP_HTTP_ADDR=:8080
APP_DATABASE_URL=postgres://omniflow:omniflow@postgres:5432/omniflow?sslmode=disable
APP_VALKEY_URL=redis://valkey:6379/0
APP_REMNAWAVE_URL=https://panel.example.com
APP_REMNAWAVE_TOKEN=
APP_OPERATOR_TOKEN=
# Base64-encoded 32-byte AES key, for example: openssl rand -base64 32
APP_DATA_ENCRYPTION_KEY=
APP_TELEGRAM_TOKEN=
APP_SUPPORT_URL=https://t.me/example_support
APP_TERMS_URL=
# Public base URL used for payment-provider return links. Required by YooKassa.
APP_PUBLIC_URL=

# Settlement currency the bot compares plan prices in. Use XTR for a
# Telegram-Stars-only installation.
APP_DEFAULT_CURRENCY=RUB

# Customer communication controls.
APP_MARKETING_FREQUENCY_CAP=3
APP_MARKETING_WINDOW_HOURS=168
APP_RECOVERY_WINDOW_HOURS=336
APP_TRIAL_MINIMUM_ACCOUNT_AGE_HOURS=0

# Payment adapters are enabled only when their credentials are configured.
APP_CRYPTOBOT_TOKEN=
APP_CRYPTOBOT_TESTNET=true
APP_YOOKASSA_SHOP_ID=
APP_YOOKASSA_SECRET=

# Customer-initiated wallet top-up. Amounts are minor units of
# APP_DEFAULT_CURRENCY. A preset the limits would refuse is never offered.
APP_WALLET_TOPUP_ENABLED=true
APP_WALLET_TOPUP_PRESETS=10000,30000,50000,100000
APP_WALLET_TOPUP_MINIMUM_MINOR=10000
APP_WALLET_TOPUP_MAXIMUM_MINOR=5000000
APP_WALLET_TOPUP_WINDOW_LIMIT_MINOR=10000000
APP_WALLET_TOPUP_WINDOW_HOURS=24

# How long a saved cart waits for the balance to cover it.
APP_CART_TTL_HOURS=720

# Several concurrent subscriptions per customer. Off by default, which is what
# every installation upgraded from v0.4 already has.
APP_MULTI_SUBSCRIPTION_ENABLED=false
APP_MAX_SUBSCRIPTIONS_PER_CUSTOMER=3

# Telegram webhook mode. Long polling is used when the URL is empty and stays
# supported as an explicit development and fallback mode.
# Generate the secret with: openssl rand -hex 32
APP_TELEGRAM_WEBHOOK_URL=
APP_TELEGRAM_WEBHOOK_SECRET=
APP_BOT_HTTP_ADDR=:8082

# Operational endpoints: /livez, /readyz, and /metrics.
APP_METRICS_ENABLED=true
APP_WORKER_HTTP_ADDR=:8081
# Leave empty to keep the bot off HTTP entirely.
APP_BOT_METRICS_ADDR=

# Operator notifications. Supply a Telegram group with topics enabled; the bot
# creates and binds every topic itself.
APP_OPERATOR_CHAT_ID=
APP_OPERATOR_TELEGRAM_IDS=
APP_OPERATOR_NOTIFICATION_CAP=30
APP_OPERATOR_NOTIFICATION_WINDOW_MINUTES=5

# Encrypted PostgreSQL backups. The encryption key is separate from
# APP_DATA_ENCRYPTION_KEY and must be stored outside the backup itself:
#   openssl rand -base64 32
APP_BACKUP_ENABLED=false
APP_BACKUP_ENCRYPTION_KEY=
APP_BACKUP_DIR=/var/lib/omniflow/backups
APP_BACKUP_INTERVAL_HOURS=24
APP_BACKUP_RETENTION_DAYS=14

# Maintenance mode blocks new purchases and holds provisioning. It never
# disturbs an order that is already paid.
APP_MAINTENANCE_AUTO_DETECT=true
APP_MAINTENANCE_PROBE_SECONDS=30
APP_MAINTENANCE_FAILURE_STREAK=3
APP_MAINTENANCE_RECOVERY_STREAK=3

# Retention only removes disposable operational data. Financial, audit,
# consent, identity, and entitlement history is never deleted.
APP_RETENTION_OUTBOX_DAYS=7
APP_RETENTION_TELEMETRY_DAYS=30
APP_RETENTION_DRIFT_DAYS=90
APP_RETENTION_INTERVAL_HOURS=1

# The operator panel at /admin, served by the /v1/panel API. It reuses
# APP_DATA_ENCRYPTION_KEY to seal TOTP secrets, so that key is required.
#
# The worker reads the same key from v0.7 onward: it delivers digital goods and
# refreshes external blocklists, and both unseal a provider credential the panel
# wrote. It is optional there — without it the worker logs that digital goods
# delivery is disabled and runs everything else.
#
# On first start, when no administrator exists yet, the API writes a one-time
# setup token to its log. Redeem it at /admin/setup to create the first owner.
APP_ADMIN_PANEL_ENABLED=true
APP_ADMIN_TOTP_ISSUER=Omniflow

# Set to false only for a local plain-HTTP stack. Without Secure, the session
# cookie can be captured from any unencrypted request to the same host.
APP_ADMIN_COOKIE_SECURE=true

# Customer web panel (/account, backed by /v1/account). Needs
# APP_DATA_ENCRYPTION_KEY, which seals OIDC client secrets and the sign-in flow
# cookie. Telegram sign-in reuses APP_TELEGRAM_TOKEN and needs the bot's domain
# bound with /setdomain in BotFather.
APP_CUSTOMER_PANEL_ENABLED=true

# Set to false only for a local plain-HTTP stack, as above.
APP_CUSTOMER_COOKIE_SECURE=true

# The bot-delivered sign-in link, off by default: it is a second bearer
# credential travelling through a chat. Turning it on enables the bot's /login
# command and requires APP_PUBLIC_URL.
APP_CUSTOMER_MAGIC_LINK_ENABLED=false

# Comma-separated IPs or CIDR blocks whose X-Forwarded-For may be believed.
# Leave empty when the API is exposed directly: the header is then ignored and
# the socket address is used. This feeds rate limiting and the audit trail.
APP_TRUSTED_PROXIES=

# Anonymous, privacy-preserving project telemetry is enabled by default.
APP_TELEMETRY_ENABLED=true
APP_TELEMETRY_ENDPOINT=https://telemetry.omniflw.xyz/v1/telemetry/events
APP_TELEMETRY_COLLECTOR_ENABLED=false

NEXT_PUBLIC_API_URL=http://localhost:8080
