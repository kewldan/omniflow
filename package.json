{
  "name": "omniflow",
  "private": true,
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "bun --filter '@omniflow/*' build",
    "check": "bun --filter '@omniflow/*' check",
    "dev:web": "bun --filter @omniflow/web dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "generate:api": "orval --config orval.config.ts --formatter biome --fail-on-warnings",
    "ui:add": "shadcn add"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "orval": "8.48.0",
    "shadcn": "4.23.0",
    "typescript": "7.0.2"
  }
}
