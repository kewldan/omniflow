# Environment for deploy/migration/*.sh. Copy this file OUTSIDE the
# repository, fill it in, `chmod 600` it, and load it before a script:
#
#   set -a; . /root/omniflow-migration.env; set +a
#
# Never commit the filled-in copy.

# Where dumps, reports, and the cutover time are written.
MIGRATION_DIR=/root/bedolaga-migration
# The importer binary: go build -o migrate-bedolaga ./cmd/migrate-bedolaga
MIGRATE_BEDOLAGA=/root/bin/migrate-bedolaga
MAPPING_FILE=/root/bedolaga-mapping.yaml

# Bedolaga's database container (docker-compose defaults).
BEDOLAGA_DB_CONTAINER=remnawave_bot_db
BEDOLAGA_DB_NAME=remnawave_bot
BEDOLAGA_DB_USER=remnawave_user
BEDOLAGA_BOT_CONTAINER=remnawave_bot
# BEDOLAGA_EXTRA_CONTAINERS="cabinet_frontend"

# What the importer reads Bedolaga through. For a rehearsal, 02-restore-staging.sh
# writes this for you; for the cutover, point it at the production database
# with a role that can only SELECT.
APP_BEDOLAGA_DATABASE_URL=

# Omniflow: the same values the API uses.
APP_DATABASE_URL=
APP_DATA_ENCRYPTION_KEY=
APP_REMNAWAVE_URL=
APP_REMNAWAVE_TOKEN=
APP_PUBLIC_URL=
# The bot token Bedolaga used (BOT_TOKEN); the same Telegram bot moves over.
APP_TELEGRAM_TOKEN=

# Cutover options.
OMNIFLOW_TELEGRAM_MODE=webhook
# OMNIFLOW_BOT_CONTAINER=omniflow-bot-1
# OMNIFLOW_WORKER_CONTAINER=omniflow-worker-1
# OMNIFLOW_DB_CONTAINER=omniflow-postgres-1
PAYMENT_PROVIDERS="yookassa"
# SAMPLE_SUBSCRIPTION_URL=
